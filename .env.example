# ─────────────────────────────────────────────
# SSCSP environment template — copy to .env and fill in
# NEVER commit the real .env
# ─────────────────────────────────────────────

# Database
DATABASE_URL=postgresql+psycopg://sscsp:sscsp_dev_pw@db:5432/sscsp
POSTGRES_USER=sscsp
POSTGRES_PASSWORD=change_me_in_prod
POSTGRES_DB=sscsp

# Auth
JWT_SECRET=replace-with-32-byte-random-string
ACCESS_TOKEN_MINUTES=30

# Policy
BLOCK_CVSS=7.0

# External integrations
OSV_API_URL=https://api.osv.dev/v1/query
OSV_API_KEY=

# Signing (demo only — production uses HSM/KMS)
SIGN_KEY=demo-signing-key-do-not-use-in-prod
